{
  "name": "afdian-key-system",
  "version": "1.0.0",
  "description": "基于 Cloudflare Workers + D1 的爱发电授权码发放与校验系统",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "genkey": "node scripts/genkey.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute afdian_keys --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute afdian_keys --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
